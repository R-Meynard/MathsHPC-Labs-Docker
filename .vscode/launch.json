{
  "version": "0.2.0",
  "configurations": [
    // ============================================================
    // C++ - GDB (works well for most Linux C++ debugging)
    // ============================================================
    {
      "name": "C++: Launch (gdb) - pick executable",
      "type": "cppdbg",
      "request": "launch",
      "MIMode": "gdb",
      "program": "${command:pickFile}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "setupCommands": [
        { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },

    // ============================================================
    // C++ - LLDB (via cpptools, good alternative to gdb)
    // Note: depending on your setup, this may use lldb-mi or lldb-dap.
    // If it fails, use the CodeLLDB config below for LLDB.
    // ============================================================
    {
      "name": "C++: Launch (lldb) - pick executable",
      "type": "cppdbg",
      "request": "launch",
      "MIMode": "lldb",
      "program": "${command:pickFile}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false
    },

    // ============================================================
    // Rust - CodeLLDB (recommended)
    // You pick the compiled binary (target/debug/<bin> or target/release/<bin>)
    // ============================================================
    {
      "name": "Rust: Launch (CodeLLDB) - pick executable",
      "type": "lldb",
      "request": "launch",
      "program": "${command:pickFile}",
      "args": [],
      "cwd": "${workspaceFolder}"
    },

    // ============================================================
    // Python - debugpy (VS Code Python extension)
    // Debug the currently opened file
    // ============================================================
    {
      "name": "Python: Current file (debugpy)",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },

    // ============================================================
    // Python - Module (useful for "python -m package.module")
    // ============================================================
    {
      "name": "Python: Module (debugpy)",
      "type": "python",
      "request": "launch",
      "module": "${input:pythonModule}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],

  "inputs": [
    {
      "id": "pythonModule",
      "type": "promptString",
      "description": "Python module to run (like: package.module)",
      "default": "main"
    }
  ]
}